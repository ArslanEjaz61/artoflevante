// Restaurant Loyalty PWA — data model
//
// The rule that shapes everything here: a customer belongs to the company, not
// to a branch. Only a Transaction carries a branchId. That is what lets points
// earned in one branch be spent in another while branch reporting still works.

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- branches

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameAr    String? // Arabic name
  address   String?
  addressAr String?
  phone     String?
  hours     String?
  city      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  dailyCode          String?
  dailyCodeExpiresAt DateTime?

  homeCustomers Customer[]      @relation("HomeBranch")
  staff         Staff[]
  transactions  Transaction[]
  offers        OfferBranch[]
  visits        CustomerVisit[]

  @@index([isActive])
}

// ---------------------------------------------------------------- customers

model Customer {
  id        String    @id @default(cuid())
  mobile    String    @unique // E.164, the login identity
  name      String
  email     String?
  birthday  DateTime? @db.Date
  language  String    @default("en") // "en" | "ar"
  isBlocked Boolean   @default(false)

  homeBranchId String?
  homeBranch   Branch? @relation("HomeBranch", fields: [homeBranchId], references: [id])

  pointsBalance Int       @default(0)
  visitCount    Int       @default(0)
  totalSpend    Decimal   @default(0) @db.Decimal(12, 2)
  lastVisitAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qrTokens        QrToken[]
  transactions    Transaction[]
  pointsLedger    PointsLedger[]
  customerRewards CustomerReward[]
  visits          CustomerVisit[]

  @@index([homeBranchId])
  @@index([createdAt])
  @@index([lastVisitAt])
}

// One-time codes for sign-up and sign-in.
model OtpCode {
  id         String    @id @default(cuid())
  mobile     String
  codeHash   String // hashed, never stored in the clear
  purpose    String    @default("register") // "register" | "login"
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  pendingName     String?
  pendingEmail    String?
  pendingBirthday DateTime? @db.Date
  pendingBranchId String?

  @@index([mobile, purpose])
  @@index([expiresAt])
}

// The QR shown on the loyalty card. Short-lived by design.
model QrToken {
  id         String    @id @default(cuid())
  token      String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- staff

model Staff {
  id       String  @id @default(cuid())
  username String  @unique
  name     String
  pinHash  String // scrypt hash of the till PIN
  role     Role    @default(CASHIER)
  isActive Boolean @default(true)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime  @default(now())
  lastLogin DateTime?

  transactions Transaction[]
  auditLogs    AuditLog[]

  @@index([branchId])
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  BRANCH_MANAGER
  CASHIER
}

// ---------------------------------------------------------------- transactions

model Transaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  staffId    String?
  staff      Staff?   @relation(fields: [staffId], references: [id])

  invoiceNumber String
  amount        Decimal @db.Decimal(12, 2)
  pointsEarned  Int     @default(0)
  discountGiven Decimal @default(0) @db.Decimal(12, 2)

  isReversed    Boolean   @default(false)
  reversedAt    DateTime?
  reverseReason String?

  createdAt DateTime @default(now())

  pointsLedger    PointsLedger[]
  customerRewards CustomerReward[]

  @@unique([branchId, invoiceNumber])
  @@index([customerId])
  @@index([branchId, createdAt])
  @@index([createdAt])
}

// Points ledger audit trail
model PointsLedger {
  id            String       @id @default(cuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  delta  Int // positive to earn, negative to redeem
  reason String // "purchase" | "reward_redemption" | "welcome" | "referral" | "birthday" | "correction" | "expiry"
  note   String?

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([customerId, createdAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- rewards

model Reward {
  id            String  @id @default(cuid())
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?

  type      RewardType
  threshold Int // points needed, or visit number
  value     Decimal    @default(0) @db.Decimal(12, 2)
  isPercent Boolean    @default(false)

  validDays Int?     @default(30)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  customerRewards CustomerReward[]

  @@index([isActive])
}

enum RewardType {
  WELCOME
  POINTS
  VISITS
  BIRTHDAY
  REFERRAL
  MANUAL
}

// A reward that has been issued to a customer
model CustomerReward {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rewardId   String
  reward     Reward   @relation(fields: [rewardId], references: [id])

  status     RewardStatus @default(AVAILABLE)
  issuedAt   DateTime     @default(now())
  expiresAt  DateTime?
  redeemedAt DateTime?

  redeemedTxId String?
  redeemedTx   Transaction? @relation(fields: [redeemedTxId], references: [id])

  @@index([customerId, status])
  @@index([expiresAt])
}

enum RewardStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

// ---------------------------------------------------------------- offers

model Offer {
  id            String  @id @default(cuid())
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?

  discountValue Decimal @default(0) @db.Decimal(12, 2)
  isPercent     Boolean @default(true)

  segment   String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  branches OfferBranch[]

  @@index([isActive])
}

model OfferBranch {
  offerId  String
  offer    Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([offerId, branchId])
}

// ---------------------------------------------------------------- audit

model AuditLog {
  id      String  @id @default(cuid())
  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  action     String
  entityType String?
  entityId   String?
  reason     String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([staffId])
  @@index([action])
}

// ---------------------------------------------------------------- settings

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- customer visits

model CustomerVisit {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  couponCode    String
  pointsEarned  Int      @default(0)
  checkInMethod String   @default("CUSTOMER_PORTAL") // "CUSTOMER_PORTAL" | "STAFF_POS" | "QR_SCAN"
  note          String?
  createdAt     DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([branchId, createdAt])
  @@index([createdAt])
}
